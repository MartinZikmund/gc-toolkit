<Project ToolsVersion="15.0">
  <ItemGroup>
    <PackageVersion Include="MZikmund.Toolkit.WinUI" Version="0.1.21-dev.69" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.91" />
    <!-- Enables `dotnet run` for the packaged WinAppSDK head. -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1" />
    <!-- Pinned directly to resolve NU1605: Uno.UI.HotDesign requires a newer BuildTools
         than the WindowsAppSDK graph would otherwise select. -->
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <!-- Source generator (Roslyn analyzer) -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <!-- Community Toolkit -->
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageVersion Include="CommunityToolkit.WinUI.Converters" Version="8.2.251219" />
    <!-- No test-package entries here: the test projects live under tests/, outside this
         CPM scope, and pin their versions through MSTest.Sdk. -->
  </ItemGroup>
</Project>