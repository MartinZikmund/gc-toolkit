<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GcToolkit.Converters">

    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Invert="True" />
    <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <converters:NullToVisibilityConverter x:Key="InvertedNullToVisibilityConverter" Invert="True" />
    <converters:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    <converters:StringVisibilityConverter x:Key="InvertedStringVisibilityConverter" Invert="True" />
    <converters:EnumLocalizationConverter x:Key="EnumLocalizationConverter" />
    <converters:IconKeyToIconConverter x:Key="IconKeyToIconConverter" />
    <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    <converters:LocalizationKeyConverter x:Key="LocalizationKeyConverter" />

</ResourceDictionary>
