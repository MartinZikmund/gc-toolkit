<local:ChecksumViewBase
    x:Class="GcToolkit.Views.ChecksumView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:numbers="using:GcToolkit.Core.Numbers"
    xmlns:vm="using:GcToolkit.Core.ViewModels.Tools">

    <local:ChecksumViewBase.Resources>
        <Style x:Key="ChecksumCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  The working: quieter than the answer it adds up to.  -->
        <Style
            x:Key="ChecksumWorkingTextStyle"
            BasedOn="{StaticResource MonoTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  The reduction chain — the line a cacher copies down.  -->
        <Style
            x:Key="ChecksumChainTextStyle"
            BasedOn="{StaticResource MonoTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style
            x:Key="ChecksumColumnHeaderTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </local:ChecksumViewBase.Resources>

    <controls:ToolPage
        CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
        ShareCommand="{x:Bind ViewModel.ShareOutputCommand}"
        Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=ChecksumInputLabel}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{markup:Localize Key=ChecksumInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.UseExampleCommand}" Content="{markup:Localize Key=ChecksumExample}" />
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=ChecksumClear}" />
            </StackPanel>

            <!--  Options  -->
            <StackPanel Spacing="4">
                <CheckBox Content="{markup:Localize Key=ChecksumShowWorking}" IsChecked="{x:Bind ViewModel.ShowWorking, Mode=TwoWay}" />
                <CheckBox Content="{markup:Localize Key=ChecksumFoldDiacritics}" IsChecked="{x:Bind ViewModel.FoldDiacritics, Mode=TwoWay}" />
                <CheckBox Content="{markup:Localize Key=ChecksumShowParts}" IsChecked="{x:Bind ViewModel.ShowParts, Mode=TwoWay}" />
            </StackPanel>

            <!--  Other cross sums: alternating is always on, base and modulo are opt-in  -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChecksumVariantsHeader}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ChecksumVariantsHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander.Header>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=ChecksumInputBaseLabel}"
                        ItemsSource="{x:Bind vm:ChecksumViewModel.BaseOptions}"
                        SelectedItem="{x:Bind ViewModel.InputBase, Mode=TwoWay}" />
                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=ChecksumDigitBaseLabel}"
                        ItemsSource="{x:Bind vm:ChecksumViewModel.BaseOptions}"
                        SelectedItem="{x:Bind ViewModel.DigitBase, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="2"
                        Header="{markup:Localize Key=ChecksumModulusLabel}"
                        Minimum="1"
                        PlaceholderText="{markup:Localize Key=ChecksumModulusPlaceholder}"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.Modulus, Mode=TwoWay}" />
                </Grid>
            </Expander>

            <!--  Empty state  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=ChecksumEmptyHint}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

            <!--  Answer  -->
            <Border Style="{StaticResource ToolReadoutSurfaceStyle}" Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource ReadoutForegroundBrush}"
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=ChecksumTotalLabel}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="32"
                                LineHeight="40"
                                Style="{StaticResource ToolReadoutTextStyle}"
                                Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource ReadoutForegroundBrush}"
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=ChecksumRootLabel}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="32"
                                LineHeight="40"
                                Style="{StaticResource ToolReadoutTextStyle}"
                                Text="{x:Bind ViewModel.RootText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Opacity="0.8"
                        Style="{StaticResource ToolReadoutTextStyle}"
                        Text="{x:Bind ViewModel.TotalReductionLine, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowTotalReduction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!--  How the answer was reached  -->
            <Border Style="{StaticResource ChecksumCardStyle}" Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowDigits, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChecksumDigitsHeader}" />
                        <TextBlock
                            Style="{StaticResource ChecksumWorkingTextStyle}"
                            Text="{x:Bind ViewModel.DigitWorkingLine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.DigitWorkingLine, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource ChecksumChainTextStyle}" Text="{x:Bind ViewModel.DigitReductionLine, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.ShowLetters, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChecksumLettersHeader}" />
                        <TextBlock
                            Style="{StaticResource ChecksumWorkingTextStyle}"
                            Text="{x:Bind ViewModel.LetterWorkingLine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LetterWorkingLine, Mode=OneWay, Converter={StaticResource StringVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource ChecksumChainTextStyle}" Text="{x:Bind ViewModel.LetterReductionLine, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SkippedNote, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasSkippedNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!--  Part by part — each group of a coordinate line scored on its own  -->
            <Border Style="{StaticResource ChecksumCardStyle}" Visibility="{x:Bind ViewModel.ShowPartList, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ChecksumPartsHeader}" />

                    <Grid Padding="8,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Style="{StaticResource ChecksumColumnHeaderTextStyle}"
                            Text="{markup:Localize Key=ChecksumPartColumn}" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource ChecksumColumnHeaderTextStyle}"
                            Text="{markup:Localize Key=ChecksumSumColumn}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource ChecksumColumnHeaderTextStyle}"
                            Text="{markup:Localize Key=ChecksumRootColumn}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="numbers:ChecksumPart">
                                <Grid
                                    Margin="0,1"
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Text="{x:Bind Text}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Text="{x:Bind Total}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource BrandPrimaryBrush}"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Text="{x:Bind Root}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Alternating / modulo / base cross sums  -->
            <Border Style="{StaticResource ChecksumCardStyle}" Visibility="{x:Bind ViewModel.HasVariants, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.VariantRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChecksumVariantLine">
                            <StackPanel Margin="0,0,0,12" Spacing="4">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Label}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource BrandPrimaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Text="{x:Bind Value}" />
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource ChecksumWorkingTextStyle}"
                                    Text="{x:Bind Working}"
                                    Visibility="{x:Bind HasWorking, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasVariantError, Mode=OneWay}"
                Message="{x:Bind ViewModel.VariantError, Mode=OneWay}"
                Severity="Warning" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasTruncationNote, Mode=OneWay}"
                Message="{x:Bind ViewModel.TruncationNote, Mode=OneWay}"
                Severity="Informational" />

            <!--  Coordinate checksum: the figure a cache page publishes  -->
            <Border Style="{StaticResource ChecksumCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="{markup:Localize Key=ChecksumCoordinateHeader}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="{markup:Localize Key=ChecksumCoordinateLabel}" />
                        <TextBox
                            MinHeight="96"
                            AcceptsReturn="True"
                            AutomationProperties.Name="{markup:Localize Key=ChecksumCoordinateLabel}"
                            FontFamily="{StaticResource MonospaceFontFamily}"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="{markup:Localize Key=ChecksumCoordinatePlaceholder}"
                            Text="{x:Bind ViewModel.CoordinateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=ChecksumCoordinateHint}"
                        TextWrapping="Wrap" />

                    <ToggleSwitch
                        IsOn="{x:Bind ViewModel.UseDdmMode, Mode=TwoWay}"
                        OffContent="{markup:Localize Key=ChecksumModeAsEntered}"
                        OnContent="{markup:Localize Key=ChecksumModeDdm}" />

                    <StackPanel
                        HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button Command="{x:Bind ViewModel.UseCoordinateExampleCommand}" Content="{markup:Localize Key=ChecksumExample}" />
                        <Button Command="{x:Bind ViewModel.ClearCoordinatesCommand}" Content="{markup:Localize Key=ChecksumClear}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CoordinateRows, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasCoordinateRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChecksumCoordinateLine">
                                <Grid
                                    Margin="0,2"
                                    Padding="12,8"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Style="{StaticResource MonoTextBlockStyle}"
                                            Text="{x:Bind Input}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource MonoTextBlockStyle}"
                                            Text="{x:Bind Normalized}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind HasNormalized, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Detail}"
                                            Visibility="{x:Bind HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusText}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsMatch, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind StatusText}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind IsProblem, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind IsValid, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock
                                            FontSize="20"
                                            Style="{StaticResource MonoTextBlockStyle}"
                                            Text="{x:Bind TotalText}" />
                                        <TextBlock
                                            VerticalAlignment="Bottom"
                                            Foreground="{ThemeResource BrandPrimaryBrush}"
                                            Style="{StaticResource MonoTextBlockStyle}"
                                            Text="{x:Bind RootText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=ChecksumMethodNote}"
                TextWrapping="Wrap" />

        </StackPanel>
    </controls:ToolPage>
</local:ChecksumViewBase>
