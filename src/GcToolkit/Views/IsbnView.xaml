<local:IsbnViewBase
    x:Class="GcToolkit.Views.IsbnView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:isbn="using:GcToolkit.Core.Isbn"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    x:Name="PageRoot">

    <local:IsbnViewBase.Resources>
        <Style x:Key="IsbnCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AppStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style
            x:Key="IsbnWorkingTextStyle"
            BasedOn="{StaticResource MonoTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </local:IsbnViewBase.Resources>

    <controls:ToolPage
        CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
        ShareCommand="{x:Bind ViewModel.ShareOutputCommand}"
        Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">

            <RadioButtons
                Header="{markup:Localize Key=IsbnStandardHeader}"
                MaxColumns="4"
                SelectedIndex="{x:Bind ViewModel.StandardIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=IsbnStandard_Isbn}" />
                <RadioButton Content="{markup:Localize Key=IsbnStandard_Issn}" />
                <RadioButton Content="{markup:Localize Key=IsbnStandard_Ean13}" />
                <RadioButton Content="{markup:Localize Key=IsbnStandard_UpcA}" />
            </RadioButtons>

            <!--  Input  -->
            <TextBox
                FontFamily="{ThemeResource AppMonoFontFamily}"
                FontSize="20"
                Header="{markup:Localize Key=IsbnInputLabel}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{markup:Localize Key=IsbnInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.UseExampleCommand}" Content="{markup:Localize Key=IsbnExample}" />
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=IsbnClear}" />
            </StackPanel>

            <CheckBox Content="{markup:Localize Key=IsbnShowWorking}" IsChecked="{x:Bind ViewModel.ShowWorking, Mode=TwoWay}" />

            <!--  Empty state  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="{markup:Localize Key=IsbnEmptyHint}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

            <!--  Valid / invalid badge, with the reason  -->
            <InfoBar
                Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasOutput, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <!--  Every equivalent form at once  -->
            <Border Style="{StaticResource ToolReadoutSurfaceStyle}" Visibility="{x:Bind ViewModel.HasForms, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Forms, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:IsbnFormItem">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                                            Opacity="0.7"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Label}" />
                                        <TextBlock
                                            FontSize="28"
                                            LineHeight="36"
                                            Style="{StaticResource ToolReadoutTextStyle}"
                                            Text="{x:Bind Code}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{markup:Localize Key=IsbnCopyCode}"
                                        Command="{Binding DataContext.CopyCodeCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind Code}"
                                        ToolTipService.ToolTip="{markup:Localize Key=IsbnCopyCode}">
                                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        Foreground="{ThemeResource ReadoutForegroundBrush}"
                        Opacity="0.8"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConversionNote, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasConversionNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!--  Step-by-step check-digit math  -->
            <Border Style="{StaticResource IsbnCardStyle}" Visibility="{x:Bind ViewModel.HasWorking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=IsbnWorkingHeader}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource IsbnWorkingTextStyle}"
                        Text="{x:Bind ViewModel.WorkingTermsLine, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource IsbnWorkingTextStyle}" Text="{x:Bind ViewModel.WorkingRemainderLine, Mode=OneWay}" />
                    <TextBlock
                        FontSize="18"
                        Style="{StaticResource IsbnWorkingTextStyle}"
                        Text="{x:Bind ViewModel.WorkingCheckLine, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Typo fixes for an invalid code  -->
            <Border Style="{StaticResource IsbnCardStyle}" Visibility="{x:Bind ViewModel.HasCorrections, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=IsbnCorrectionsHeader}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=IsbnCorrectionsHint}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Corrections, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:IsbnCorrectionItem">
                                <Grid
                                    Margin="0,1"
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource MonoTextBlockStyle}"
                                        Text="{x:Bind Code}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!--  Solver candidates for ? digits  -->
            <Border Style="{StaticResource IsbnCardStyle}" Visibility="{x:Bind ViewModel.HasSolutions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=IsbnSolutionsHeader}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Solutions, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid
                                    ItemHeight="32"
                                    ItemWidth="150"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.SolutionsTruncatedNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSolutionsTruncatedNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!--  Opt-in online book lookup  -->
            <Border Style="{StaticResource IsbnCardStyle}" Visibility="{x:Bind ViewModel.HasLookupLinks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=IsbnLookupHeader}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LookupLinks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid
                                    ItemHeight="36"
                                    ItemWidth="140"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="isbn:BookLookupLink">
                                <HyperlinkButton Content="{x:Bind Name}" NavigateUri="{x:Bind Uri}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=IsbnLookupNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=IsbnMethodNote}"
                TextWrapping="Wrap" />

        </StackPanel>
    </controls:ToolPage>
</local:IsbnViewBase>
