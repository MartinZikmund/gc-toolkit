<local:SettingsViewBase
    x:Class="GcToolkit.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="1">
            <StackPanel
                x:Name="ContentRoot"
                Padding="24"
                Orientation="Vertical"
                Spacing="8">

                <!--  Page header  -->
                <TextBlock
                    Margin="0,0,0,16"
                    Style="{ThemeResource TitleLargeTextBlockStyle}"
                    Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />

                <!--  General section  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=General}" />

                <toolkit:SettingsCard Header="{markup:Localize Key=Theme}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE793;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions}" SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="ElementTheme">
                                <TextBlock Text="{x:Bind Converter={StaticResource EnumLocalizationConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard Header="{markup:Localize Key=Language}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{x:Bind ViewModel.Languages}"
                        SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <InfoBar
                    IsOpen="{x:Bind ViewModel.ShowLanguageRestartNotice, Mode=TwoWay}"
                    Message="{markup:Localize Key=LanguageRestartNotice}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ViewModel.RestartAppCommand}"
                            Content="{markup:Localize Key=RestartNow}"
                            Visibility="{x:Bind ViewModel.CanRestartApp}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <toolkit:SettingsCard Header="{markup:Localize Key=ClearRecents}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button Command="{x:Bind ViewModel.ClearRecentsCommand}" Content="{markup:Localize Key=Clear}" />
                </toolkit:SettingsCard>

                <!--  About section  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=About}" />

                <toolkit:SettingsCard Description="{markup:Localize Key=AboutAppDescription}" Header="{markup:Localize Key=ApplicationName}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Icons/icon_foreground.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <TextBlock Text="{x:Bind ViewModel.AppVersion}" />
                </toolkit:SettingsCard>

                <!--  GPLv3 warranty disclaimer  -->
                <TextBlock
                    Margin="4,0,4,4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=AboutLicenseNotice}"
                    TextWrapping="Wrap" />

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.OpenPrivacyPolicyCommand}"
                    Header="{markup:Localize Key=PrivacyPolicy}"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.OpenSourceCodeCommand}"
                    Header="{markup:Localize Key=SourceCode}"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.OpenLicenseCommand}"
                    Description="{markup:Localize Key=LicenseDescription}"
                    Header="{markup:Localize Key=License}"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.OpenThirdPartyNoticesCommand}"
                    Header="{markup:Localize Key=ThirdPartyNotices}"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard
                    Command="{x:Bind ViewModel.OpenFeedbackCommand}"
                    Header="{markup:Localize Key=SendFeedback}"
                    IsClickEnabled="True">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED15;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <toolkit:SettingsCard.ActionIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </toolkit:SettingsCard.ActionIcon>
                </toolkit:SettingsCard>

                <!--  Debug section  -->
                <StackPanel Visibility="{x:Bind ViewModel.IsDebug}">
                    <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="{markup:Localize Key=Debugging}" />

                    <toolkit:SettingsCard Header="{markup:Localize Key=ClearPreferences}">
                        <Button Command="{x:Bind ViewModel.ClearPreferencesCommand}" Content="{markup:Localize Key=Clear}" />
                    </toolkit:SettingsCard>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!--  Responsive padding  -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="768" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentRoot.Padding" Value="24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:SettingsViewBase>
