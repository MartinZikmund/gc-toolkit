<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Uno 7's UNOB0029 head check exempts test projects via IsTestProject, which MSTest.Sdk sets too late for it. -->
    <IsTestProject>true</IsTestProject>
    <!--
      Uno's _UnoAddAssetsFilesToCopyLocal rewrites content Links to sit under a folder named after the
      project, which catches MSTest 4.4.0's localized adapter resources: they land in
      bin/<cfg>/<tfm>/GcToolkit.Core.Tests/<culture>/ instead of <culture>/. On Linux that directory
      collides with the extensionless apphost of the same name and the build dies with MSB3024
      (Windows is unaffected — the apphost is .exe there). The adapter's translated messages are of no
      use to this suite, so skip the copy entirely.
    -->
    <EnableMSTestV2CopyResources>false</EnableMSTestV2CopyResources>
  </PropertyGroup>

  <ItemGroup>
    <!-- NOAA NCEI's 100-point WMM2025 test table (public domain), from WMM2025COF.zip -->
    <EmbeddedResource Include="Coordinates\Data\WMM2025_TestValues.txt" LogicalName="GcToolkit.Core.Tests.Coordinates.Data.WMM2025_TestValues.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GcToolkit.Core\GcToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Geocaches\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
